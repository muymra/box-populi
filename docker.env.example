# Copy to .env and fill in (SELF_HOSTING.md "Docker"). Never commit .env.
DOMAIN=games.example.com

INSTANCE_NAME=Box Populi
INSTANCE_CONTACT=mailto:you@example.com
# openssl rand -base64 32
ADMIN_KEY=
GROUP_CREATION=admins
SEARCH_ENGINES=allow
THEME=cube
GAME_SOURCE=wikidata
MAX_GROUPS_PER_USER=5
MAX_MEMBERS_PER_GROUP=100
# Optional, each shown at its default (SELF_HOSTING.md step 4).
#DEFAULT_POINTS=3,2,1
#OWNER_AWAY_DAYS=60
#SESSION_DAYS=400
#PLAY_SOON_DAYS=56
#PLAY_SOON_MAX=5
#HERE_RESET_HOURS=12
#ADMIN_SESSION_HOURS=12
# standard, or demo for an instance that only shows the demo group (SELF_HOSTING.md step 4).
#INSTANCE_MODE=standard

# Once BoardGameGeek approves your application:
BGG_TOKEN=
# Leave empty: BGG turns on when BGG_TOKEN is set. Set off to keep it off even with a token.
#BGG_MODE=
# The gap between BGG requests in milliseconds; 2000 is the minimum. Raise it if BGG asks you to.
#BGG_MIN_INTERVAL_MS=2000
