// Cloudflare Workers instead of Pages (SELF_HOSTING.md "Cloudflare Workers"). Copy this over
// wrangler.jsonc. Same build, same database; `main` and `assets` tell the adapter to build for
// Workers. Deploy with `pnpm exec wrangler deploy`, secrets with `wrangler secret put`.
{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "box-populi",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-11-06",
	"compatibility_flags": ["nodejs_als"],
	"assets": { "binding": "ASSETS", "directory": ".svelte-kit/cloudflare" },
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "box-populi",
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "migrations"
		}
	],
	"vars": {
		"BGG_MODE": "",
		"BGG_MIN_INTERVAL_MS": "2000",
		"INSTANCE_NAME": "Box Populi",
		"INSTANCE_CONTACT": "mailto:you@example.com",
		"GROUP_CREATION": "admins",
		"INSTANCE_MODE": "standard",
		"SEARCH_ENGINES": "allow",
		"THEME": "cube",
		"GAME_SOURCE": "wikidata",
		"MAX_GROUPS_PER_USER": "5",
		"MAX_MEMBERS_PER_GROUP": "100",
		// Podium points for groups that haven't set their own, first place first. Each group can change its own.
		"DEFAULT_POINTS": "3,2,1",
		// Days the owner can be away before a co-admin may archive the group or take over as owner.
		"OWNER_AWAY_DAYS": "60",
		// Days a device stays signed in after it was last used, 1 to 400 (browsers cap cookies at 400).
		"SESSION_DAYS": "400",
		// Days a Play soon mark lasts when nothing clears it (1 to 365), and how many a person can have (1 to 20).
		"PLAY_SOON_DAYS": "56",
		"PLAY_SOON_MAX": "5",
		// Hours after the last change that who's here and kept games reset on a device, 1 to 168.
		"HERE_RESET_HOURS": "12",
		// Hours your sign-in to /admin lasts, 1 to 720.
		"ADMIN_SESSION_HOURS": "12"
	}
}
