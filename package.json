{
	"name": "box-populi",
	"version": "0.3.1",
	"private": true,
	"type": "module",
	"license": "MIT",
	"packageManager": "pnpm@12.15.0",
	"engines": {
		"node": ">=22.18"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"prepare": "node scripts/ensure-local-config.ts && (svelte-kit sync || echo '')",
		"dev": "vite dev",
		"build": "vite build",
		"preview": "wrangler pages dev .svelte-kit/cloudflare --port 4173",
		"check": "pnpm gen --check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"gen": "wrangler types --strict-vars=false",
		"gen:themes": "node scripts/gen-themes.ts",
		"test": "vitest --run",
		"test:libsql": "TEST_DB=libsql vitest --run",
		"test:watch": "vitest",
		"db:migrate": "wrangler d1 migrations apply DB --local",
		"db:seed": "node scripts/seed-demo.ts && wrangler d1 execute DB --local --file seed/demo.sql",
		"db:sandbox": "node scripts/seed-sandbox.ts && wrangler d1 execute DB --local --file seed/sandbox.sql && node scripts/seed-sandbox.ts --print",
		"deploy": "pnpm build && wrangler pages deploy"
	},
	"dependencies": {
		"@fontsource-variable/archivo": "^5.3.0",
		"@lucide/svelte": "^1.68.0",
		"fast-xml-parser": "^5.3.0"
	},
	"devDependencies": {
		"@libsql/client": "^0.18.0",
		"@sveltejs/adapter-cloudflare": "^8.0.0",
		"@sveltejs/adapter-netlify": "^7.0.1",
		"@sveltejs/adapter-node": "^6.0.1",
		"@sveltejs/adapter-vercel": "^7.0.2",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^26.6.6",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^4.1.8",
		"wrangler": "^4.97.0"
	}
}
